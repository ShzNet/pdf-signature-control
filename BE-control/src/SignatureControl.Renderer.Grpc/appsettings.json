{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    }
  },
  "Renderer": {
    "CacheRoot": "data/appearance-cache",
    "FontRegularPath": "../../assets/fonts/Arial.ttf",
    "FontBoldPath": "../../assets/fonts/Arial Bold.ttf",
    "MaxConcurrentRenders": 4
  }
}
